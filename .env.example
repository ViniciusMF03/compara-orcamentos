# Banco local (SQLite). Para PostgreSQL, troque o provider no schema.prisma e use a URL do Neon/Supabase.
DATABASE_URL="file:./dev.db"

# Leitura de listas por foto/PDF (tela "Nova lista" → Importar itens → Foto ou PDF).
